# AccessMap Backend Configuration Example
# Copy this file to .env and adjust variables for your local setup

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# MongoDB URI (e.g. mongodb://localhost:27017/accessmap or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/accessmap

# JWT Authentication Secrets (Must be set to a strong random key in production)
JWT_SECRET=your_jwt_secret_key_here_change_for_production
JWT_EXPIRES_IN=7d
