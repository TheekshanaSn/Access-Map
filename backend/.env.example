# AccessMap Backend Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# MongoDB Connection String (Replace with your actual MongoDB URI)
# Local: mongodb://localhost:27017/accessmap
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/accessmap?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/accessmap

